#!/bin/sh
# Stub obsidian-headless for container tests: no network, no account.
# Records each call (with XDG_CONFIG_HOME) in /config/ob-calls.log;
# "sync" idles like the real long-running `ob sync --continuous`.
echo "XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-} ob $*" >> /config/ob-calls.log
case "$1" in
  sync) trap 'exit 0' TERM INT; while :; do sleep 1; done ;;
  *) exit 0 ;;
esac
